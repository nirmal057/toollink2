# Environment Configuration
NODE_ENV=development
PORT=5001

# Database Configuration
# Using Local MongoDB Community Server
MONGODB_URI=mongodb://localhost:27017/toollink

# Alternative database connection (for failover)
DATABASE_URL=mongodb://localhost:27017/toollink

# Database connection options
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_CONNECTION_TIMEOUT=10000
DB_SOCKET_TIMEOUT=45000
DB_SERVER_SELECTION_TIMEOUT=10000
DB_HEARTBEAT_FREQUENCY=30000

# Database retry configuration
DB_MAX_RETRIES=5
DB_RETRY_DELAY=5000

# Database monitoring
DB_MONITORING_ENABLED=true
DB_MONITORING_INTERVAL=60000

# JWT Configuration
JWT_SECRET=dev-jwt-secret-key-2024-toollink
JWT_REFRESH_SECRET=dev-refresh-jwt-secret-key-2024-toollink
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (for password reset, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=toollinksrilanka@gmail.com
SMTP_PASS=zjhq nlhb rhjw uqxp
FROM_EMAIL=toollinksrilanka@gmail.com
FROM_NAME=ToolLink Sri Lanka

# ToolLink Admin Email Configuration (for sending emails to users)
TOOLLINK_EMAIL=toollinksrilanka@gmail.com
TOOLLINK_EMAIL_PASSWORD=zjhq nlhb rhjw uqxp

# Security Configuration
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=300000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# API Configuration
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Admin Configuration
ADMIN_EMAIL=admin@toollink.com
ADMIN_PASSWORD=admin123

# Additional Admin Emails (comma separated for notifications)
ADMIN_NOTIFICATION_EMAILS=toollinksrilanka@gmail.com,admin@toollink.com

# Support Email Configuration
SUPPORT_EMAIL=toollinksrilanka@gmail.com
SUPPORT_NAME=ToolLink Sri Lanka Support Team

# Database Backup Configuration
BACKUP_INTERVAL=86400000
BACKUP_PATH=backups/

# Notification Configuration
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_RETRY_ATTEMPTS=3
